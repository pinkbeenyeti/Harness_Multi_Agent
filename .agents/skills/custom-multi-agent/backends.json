{
  "roles": {
    "planner": {
      "routes": {
        "api-routed": {"provider": "openai", "model": "gpt-5.6-sol", "input_price_per_1m": 10.0, "output_price_per_1m": 30.0},
        "cli-routed": {"cli": "codex", "model": "gpt-5.6-sol"},
        "host-native": {}
      }
    },
    "implementer": {
      "routes": {
        "api-routed": {"provider": "anthropic", "model": "claude-sonnet-5", "input_price_per_1m": 15.0, "output_price_per_1m": 75.0},
        "cli-routed": {"cli": "claude", "model": "claude-sonnet-5"},
        "host-native": {}
      }
    },
    "critic-standard": {
      "routes": {
        "api-routed": {"provider": "google", "model": "gemini-3.5-flash", "input_price_per_1m": 0.15, "output_price_per_1m": 0.60},
        "cli-routed": {"cli": "agy", "model": "gemini-3.8-flash-medium"},
        "host-native": {}
      }
    },
    "critic-architecture": {
      "routes": {
        "api-routed": {"provider": "google", "model": "gemini-3.1-pro", "input_price_per_1m": 7.0, "output_price_per_1m": 21.0},
        "cli-routed": {"cli": "agy", "model": "gemini-3.1-pro-high"},
        "host-native": {}
      }
    },
    "fallback-efficient": {
      "routes": {
        "api-routed": {"provider": "google", "model": "gemini-3.5-flash", "input_price_per_1m": 0.15, "output_price_per_1m": 0.60},
        "cli-routed": {"cli": "agy", "model": "gemini-3.8-flash-medium"},
        "host-native": {}
      }
    }
  },
  "legacy_role_aliases": {
    "claude-main": "implementer",
    "claude-critic": "critic-standard",
    "gemini-critic": "critic-standard",
    "gemini": "critic-architecture"
  },
  "cli_allowlist": {
    "claude": {
      "binary": "claude",
      "args": ["-p", "--output-format", "json", "--permission-mode", "bypassPermissions", "--disallowedTools", "Write,Edit,Bash,NotebookEdit"],
      "model_arg": ["--model", "{model}"],
      "effort_args": {"low": ["--effort", "low"], "medium": ["--effort", "medium"], "high": ["--effort", "high"]},
      "allowed_efforts": ["low", "medium", "high"]
    },
    "codex": {
      "binary": "codex",
      "args": ["exec", "--skip-git-repo-check", "-s", "read-only", "--json"],
      "model_arg": ["-m", "{model}"],
      "effort_args": {"low": ["-c", "model_reasoning_effort=low"], "medium": ["-c", "model_reasoning_effort=medium"], "high": ["-c", "model_reasoning_effort=high"]},
      "allowed_efforts": ["low", "medium", "high"]
    },
    "agy": {
      "binary": "agy",
      "args": ["--sandbox", "--dangerously-skip-permissions", "--output-format", "json"],
      "model_arg": ["--model", "{model}"],
      "effort_args": {"low": ["--mode", "fast"], "medium": ["--mode", "plan"], "high": ["--mode", "plan"]},
      "allowed_efforts": ["low", "medium", "high"]
    }
  }
}
