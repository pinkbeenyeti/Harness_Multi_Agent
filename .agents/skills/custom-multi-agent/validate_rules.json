{
  "_comment": "limit_korean/limit_english는 exclude_code_blocks가 true면 코드펜스 바깥(산문)만 센다. limit_bytes는 코드 포함 전체 크기 상한이며, 전체 파일 재출력 대신 diff/앵커 패치를 쓰도록 강제하는 장치다.",
  "rules": {
    "context.md": {
      "limit_korean": 1500,
      "limit_english": 300
    },
    "brief.md": {
      "limit_korean": 1200,
      "limit_english": 240
    },
    "result.md": {
      "exclude_code_blocks": true,
      "limit_korean": 1200,
      "limit_english": 500,
      "limit_bytes": 15000
    },
    "critic_report.md": {
      "exclude_code_blocks": true,
      "limit_korean": 1500,
      "limit_english": 700,
      "limit_bytes": 12000
    }
  }
}
